{
  "name": "sotto",
  "productName": "Sotto",
  "version": "0.1.16",
  "description": "Private, local-first desktop transcription.",
  "main": ".webpack/main",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "electron-forge start",
    "build:screen-permission-helper": "bash scripts/build-macos-screen-permission-helper.sh",
    "package": "npm run build:screen-permission-helper && electron-forge package",
    "make": "npm run build:screen-permission-helper && electron-forge make",
    "make:mac:release": "npm run build:screen-permission-helper && SOTTO_MAC_RELEASE=1 electron-forge make --platform=darwin --arch=arm64",
    "make:windows": "electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-squirrel",
    "make:windows:zip": "electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "verify:package:mac": "node scripts/verify-packaged-app.mjs darwin-arm64",
    "verify:package:windows": "node scripts/verify-packaged-app.mjs win32-x64",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/.build/**' --exclude '**/*.integration.test.ts'",
    "test:runtime": "vitest run src/main/transcription/runtime.integration.test.ts",
    "test:runtime:mac": "npm run test:runtime",
    "test:runtime:windows": "npm run test:runtime",
    "test:watch": "vitest --exclude '**/.build/**' --exclude '**/*.integration.test.ts'",
    "setup:runtime:mac": "bash scripts/provision-darwin-arm64.sh",
    "setup:runtime:windows": "bash scripts/provision-win32-x64.sh"
  },
  "keywords": [
    "transcription",
    "local-first",
    "electron"
  ],
  "author": {
    "name": "memion01",
    "email": "116808225+XtraSaltyDev@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "^6.11.0",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "docx": "9.7.1",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sherpa-onnx-node": "1.13.4"
  }
}
